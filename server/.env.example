# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9999

# ─── Secret provider ─────────────────────────────────────────────────────────
# Options: 'env' (default) | 'infisical'
SECRET_PROVIDER=env

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=data/db/ocr.sqlite

# ─── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ────────────────────────────── OCR Providers ─────────────────────────────────
# ─── Mistral OCR ─────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-api-key-here
# ─── TabScanner ──────────────────────────────────────────────────────────────
TAB_SCANNER_API_KEY=your-tab-scanner-api-key-here
# ─── PaddleOCR Local ─────────────────────────────────────────────────────────
PADDLE_OCR_LOCAL_ENABLED=true|false
# ─── PaddleOCR API ───────────────────────────────────────────────────────────
PADDLE_OCR_ENDPOINT=https://<ID>.aistudio-app.com/layout-parsing
PADDLE_OCR_API_KEY=your-paddle-scanner-api-key-here
# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
# ─── Google Gemini ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# ─── xAI / Grok ──────────────────────────────────────────────────────────────
XAI_API_KEY=your-xai-api-key-here
# ─── llama.cpp (local, OpenAI-compatible server) ─────────────────────────────
# Run: llama-server --mmproj <clip-model> -m <vision-model> --port 8080
LLAMA_CPP_BASE_URL=http://localhost:8080/v1
# Optional: model name sent in the request (llama.cpp ignores it, default: local-model)
# LLAMA_CPP_MODEL=local-model
# ─── Tesseract.js (local, no API key required) ───────────────────────────────
# Language code(s) — default: eng. Use '+' to combine: eng+por
# Full list: https://tesseract-ocr.github.io/tessdoc/Data-Files-in-different-versions.html
TESSERACT_LANGUAGE=eng+por
# ─── Azure OCR ───────────────────────────────────────────────────────────────
AZURE_OCR_API_KEY=your-azure-ocr-api-key-here
AZURE_OCR_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# ─── AWS Textract ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# ─── Storage ──────────────────────────────────────────────────────────────────
# Options: 'local' (default) | 'onedrive'
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=data/uploads
MAX_FILE_SIZE_BYTES=20971520
# Part size for multipart uploads (default: 5 MiB)
STORAGE_PART_SIZE=5242880

# OneDrive (Client Credentials flow)
# Required if STORAGE_PROVIDER=onedrive
ONEDRIVE_CLIENT_ID=your-onedrive-client-id
ONEDRIVE_CLIENT_SECRET=your-onedrive-client-secret
ONEDRIVE_TENANT_ID=your-onedrive-tenant-id
ONEDRIVE_REFRESH_TOKEN=your-onedrive-refresh-token
# Get it using the graph client endpoint: /users/<YOUR_USER>/drive
ONEDRIVE_DRIVE_ID=your-onedrive-drive-id
# Optional: folder name in OneDrive root (default: 'UploadsForOCRApp')
ONEDRIVE_FOLDER=UploadsForOCRApp

# ─── Infisical (optional — only needed when SECRET_PROVIDER=infisical) ────────
# INFISICAL_CLIENT_ID=your_machine_client_id
# INFISICAL_CLIENT_SECRET=your_machine_client_secret
# INFISICAL_PROJECT_ID=your_infisical_project_id
# INFISICAL_ENVIRONMENT=dev
# INFISICAL_SITE_URL=https://app.infisical.com

# ─── Volumes (Docker Compose only) ───────────────────────────────────────────
DATA_PATH_VOLUME=./data
UPLOADS_PATH_VOLUME=./uploads

# ─── BudgetBakers ────────────────────────────────────────────────────────────
# BudgetBakers API Token
BUDGET_BAKERS_TOKEN=your_budget_bakers_api_token

# ─── Wallet OCR Integration (Gemini To Wallet) ──────────────────────────────
# Set to true to enable the Gemini-to-Wallet provider (disables all other providers in the UI)
# USE_WALLET_OCR_PROCESSOR_PROVIDER=false
